module ietf-dhcpv6-opt-relay-id {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-relay-id";
  prefix relay-id;

  import ietf-dhcpv6-relay {
    prefix dhc6-rly;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 5460: DHCPv6
      Bulk Leasequery.";
  reference "RFC 5460: DHCPv6 Bulk Leasequery";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 5460: DHCPv6 Bulk Leasequery";
  }

  grouping relay-id-option-group {
    description "OPTION_RELAY_ID (53) Relay-ID Option.";
    reference "RFC 5460: DHCPv6 Bulk Leasequery";
    container relay-id-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_RELAY_ID (53) Relay-ID Option option.";
      leaf enterprise-number {
        type uint32;
        description "Enterprise number.";
      }
      leaf relay-id {
        type binary;
        description "Relay identifier octets.";
      }
    }
  }

  augment
    "/dhc6-rly:dhcpv6-relay/"
      + "dhc6-rly:relay-if/"
      + "dhc6-rly:relay-options" {
    description "Add RFC 5460 options.";
    uses relay-id-option-group;
  }

}
