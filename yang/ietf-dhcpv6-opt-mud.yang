module ietf-dhcpv6-opt-mud {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-mud";
  prefix mud;

  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 6991: Common YANG Data Types";
  }
  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 8520:
      Manufacturer Usage Description Specification.";
  reference "RFC 8520: Manufacturer Usage Description Specification";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 8520: Manufacturer Usage Description Specification";
  }

  grouping mud-url-v6-option-group {
    description "OPTION_MUD_URL_V6 (112) MUD URL Option for IPv6.";
    reference "RFC 8520: Manufacturer Usage Description Specification";
    container mud-url-v6-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_MUD_URL_V6 (112) MUD URL Option for IPv6
        option.";
      leaf mud-url {
        type inet:uri;
        description "Manufacturer Usage Description URL.";
      }
    }
  }

  augment
    "/dhc6-srv:dhcpv6-server/"
      + "dhc6-srv:option-sets/"
      + "dhc6-srv:option-set" {
    description "Add RFC 8520 options.";
    uses mud-url-v6-option-group;
  }

}
