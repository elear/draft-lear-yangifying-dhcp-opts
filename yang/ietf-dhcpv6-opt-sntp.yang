module ietf-dhcpv6-opt-sntp {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-sntp";
  prefix sntp;

  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 6991: Common YANG Data Types";
  }
  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 4075: Simple
      Network Time Protocol (SNTP) Configuration Option for DHCPv6.";
  reference "RFC 4075: Simple Network Time Protocol (SNTP)
    Configuration Option for DHCPv6";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 4075: Simple Network Time Protocol (SNTP)
      Configuration Option for DHCPv6";
  }

  grouping sntp-servers-option-group {
    description "OPTION_SNTP_SERVERS (31) Simple Network Time Protocol
      Servers Option.";
    reference "RFC 4075: Simple Network Time Protocol (SNTP)
      Configuration Option for DHCPv6";
    container sntp-servers-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_SNTP_SERVERS (31) Simple Network Time
        Protocol Servers Option option.";
      leaf-list sntp-server {
        type inet:ipv6-address;
        description "SNTP server address.";
      }
    }
  }

  augment
    "/dhc6-srv:dhcpv6-server/"
      + "dhc6-srv:option-sets/"
      + "dhc6-srv:option-set" {
    description "Add RFC 4075 options.";
    uses sntp-servers-option-group;
  }

}
