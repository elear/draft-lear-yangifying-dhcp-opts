module ietf-dhcpv6-opt-relay-supplied {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-relay-supplied";
  prefix relay-su;

  import ietf-dhcpv6-relay {
    prefix dhc6-rly;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 6422:
      Relay-Supplied DHCP Options.";
  reference "RFC 6422: Relay-Supplied DHCP Options";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 6422: Relay-Supplied DHCP Options";
  }

  grouping rsoo-option-group {
    description "OPTION_RSOO (66) Relay-Supplied Options Option.";
    reference "RFC 6422: Relay-Supplied DHCP Options";
    container rsoo-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_RSOO (66) Relay-Supplied Options Option
        option.";
      leaf-list option-data {
        type binary;
        description "Encapsulated DHCP option data.";
      }
    }
  }

  augment
    "/dhc6-rly:dhcpv6-relay/"
      + "dhc6-rly:relay-if/"
      + "dhc6-rly:relay-options" {
    description "Add RFC 6422 options.";
    uses rsoo-option-group;
  }

}
