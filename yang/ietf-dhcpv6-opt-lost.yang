module ietf-dhcpv6-opt-lost {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-lost";
  prefix lost;

  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 6991: Common YANG Data Types";
  }
  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 5223: A
      DHCPv6-based Location-to-Service Translation Protocol (LoST)
      Discovery.";
  reference "RFC 5223: A DHCPv6-based Location-to-Service Translation
    Protocol (LoST) Discovery";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 5223: A DHCPv6-based Location-to-Service
      Translation Protocol (LoST) Discovery";
  }

  grouping v6-lost-option-group {
    description "OPTION_V6_LOST (51) LoST Server Option.";
    reference "RFC 5223: A DHCPv6-based Location-to-Service
      Translation Protocol (LoST) Discovery";
    container v6-lost-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_V6_LOST (51) LoST Server Option option.";
      leaf-list lost-server-uri {
        type inet:uri;
        description "LoST server URI.";
      }
    }
  }

  augment
    "/dhc6-srv:dhcpv6-server/"
      + "dhc6-srv:option-sets/"
      + "dhc6-srv:option-set" {
    description "Add RFC 5223 options.";
    uses v6-lost-option-group;
  }

}
