module ietf-dhcpv6-opt-dslite {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-dslite";
  prefix dslite;

  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 6991: Common YANG Data Types";
  }
  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 6334: Dynamic
      Host Configuration Protocol for IPv6 (DHCPv6) Option for
      Dual-Stack Lite.";
  reference "RFC 6334: Dynamic Host Configuration Protocol for IPv6
    (DHCPv6) Option for Dual-Stack Lite";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 6334: Dynamic Host Configuration Protocol for IPv6
      (DHCPv6) Option for Dual-Stack Lite";
  }

  grouping aftr-name-option-group {
    description "OPTION_AFTR_NAME (64) AFTR Name Option.";
    reference "RFC 6334: Dynamic Host Configuration Protocol for IPv6
      (DHCPv6) Option for Dual-Stack Lite";
    container aftr-name-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_AFTR_NAME (64) AFTR Name Option option.";
      leaf aftr-name {
        type inet:domain-name;
        description "AFTR fully qualified domain name.";
      }
    }
  }

  augment
    "/dhc6-srv:dhcpv6-server/"
      + "dhc6-srv:option-sets/"
      + "dhc6-srv:option-set" {
    description "Add RFC 6334 options.";
    uses aftr-name-option-group;
  }

}
