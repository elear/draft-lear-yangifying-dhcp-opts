module ietf-dhcpv6-opt-pd-exclude {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-pd-exclude";
  prefix pd-exclu;

  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 6991: Common YANG Data Types";
  }
  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 6603: Prefix
      Exclude Option for DHCPv6-based Prefix Delegation.";
  reference "RFC 6603: Prefix Exclude Option for DHCPv6-based Prefix
    Delegation";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 6603: Prefix Exclude Option for DHCPv6-based Prefix
      Delegation";
  }

  grouping pd-exclude-option-group {
    description "OPTION_PD_EXCLUDE (67) Prefix Exclude Option.";
    reference "RFC 6603: Prefix Exclude Option for DHCPv6-based Prefix
      Delegation";
    container pd-exclude-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_PD_EXCLUDE (67) Prefix Exclude Option
        option.";
      leaf excluded-prefix {
        type inet:ipv6-prefix;
        description "Excluded prefix.";
      }
    }
  }

  augment
    "/dhc6-srv:dhcpv6-server/"
      + "dhc6-srv:option-sets/"
      + "dhc6-srv:option-set" {
    description "Add RFC 6603 options.";
    uses pd-exclude-option-group;
  }

}
