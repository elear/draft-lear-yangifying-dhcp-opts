module ietf-dhcpv6-opt-sztp-redirect {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-sztp-redirect";
  prefix sztp-red;

  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 6991: Common YANG Data Types";
  }
  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 8572: Secure
      Zero Touch Provisioning (SZTP).";
  reference "RFC 8572: Secure Zero Touch Provisioning (SZTP)";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 8572: Secure Zero Touch Provisioning (SZTP)";
  }

  grouping v6-sztp-redirect-option-group {
    description "OPTION_V6_SZTP_REDIRECT (136) SZTP Redirect Option.";
    reference "RFC 8572: Secure Zero Touch Provisioning (SZTP)";
    container v6-sztp-redirect-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_V6_SZTP_REDIRECT (136) SZTP Redirect Option
        option.";
      leaf-list redirect-uri {
        type inet:uri;
        description "SZTP redirect URI.";
      }
      leaf-list redirect-data {
        type binary;
        description "Additional redirect data.";
      }
    }
  }

  augment
    "/dhc6-srv:dhcpv6-server/"
      + "dhc6-srv:option-sets/"
      + "dhc6-srv:option-set" {
    description "Add RFC 8572 options.";
    uses v6-sztp-redirect-option-group;
  }

}
