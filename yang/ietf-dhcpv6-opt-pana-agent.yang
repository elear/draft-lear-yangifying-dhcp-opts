module ietf-dhcpv6-opt-pana-agent {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-pana-agent";
  prefix pana-age;

  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 6991: Common YANG Data Types";
  }
  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 5192: DHCP
      Options for the Protocol for carrying Authentication for Network
      Access (PANA).";
  reference "RFC 5192: DHCP Options for the Protocol for carrying
    Authentication for Network Access (PANA)";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 5192: DHCP Options for the Protocol for carrying
      Authentication for Network Access (PANA)";
  }

  grouping pana-agent-option-group {
    description "OPTION_PANA_AGENT (40) PANA Agent Option.";
    reference "RFC 5192: DHCP Options for the Protocol for carrying
      Authentication for Network Access (PANA)";
    container pana-agent-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_PANA_AGENT (40) PANA Agent Option option.";
      leaf-list pana-agent-address {
        type inet:ipv6-address;
        description "PANA agent IPv6 address.";
      }
    }
  }

  augment
    "/dhc6-srv:dhcpv6-server/"
      + "dhc6-srv:option-sets/"
      + "dhc6-srv:option-set" {
    description "Add RFC 5192 options.";
    uses pana-agent-option-group;
  }

}
