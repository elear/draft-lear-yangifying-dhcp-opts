module: ietf-dhcpv6-opt-link-layer
  augment /dhc6-clnt:dhcpv6-client/dhc6-clnt:client-if/
         dhc6-clnt:client-configured-options:
    +--rw ia-ll-option!
       +--rw ia-id? uint32
       +--rw hardware-type? uint16
       +--rw link-layer-address? binary
    +--rw lladdr-option!
       +--rw hardware-type? uint16
       +--rw link-layer-address? binary
