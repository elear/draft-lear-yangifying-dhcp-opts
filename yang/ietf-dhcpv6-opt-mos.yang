module ietf-dhcpv6-opt-mos {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-mos";
  prefix mos;

  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 6991: Common YANG Data Types";
  }
  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 5678: Dynamic
      Host Configuration Protocol (DHCPv4 and DHCPv6) Options for IEEE
      802.21 Mobility Services (MoS) Discovery.";
  reference "RFC 5678: Dynamic Host Configuration Protocol (DHCPv4 and
    DHCPv6) Options for IEEE 802.21 Mobility Services (MoS) Discovery";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 5678: Dynamic Host Configuration Protocol (DHCPv4
      and DHCPv6) Options for IEEE 802.21 Mobility Services (MoS)
      Discovery";
  }

  grouping ipv6-address-mos-option-group {
    description "OPTION-IPv6_Address-MoS (54) IPv6 Address MoS Option.";
    reference "RFC 5678: Dynamic Host Configuration Protocol (DHCPv4
      and DHCPv6) Options for IEEE 802.21 Mobility Services (MoS)
      Discovery";
    container ipv6-address-mos-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION-IPv6_Address-MoS (54) IPv6 Address MoS
        Option option.";
      leaf service-type {
        type uint16;
        description "IEEE 802.21 service type.";
      }
      leaf-list server-address {
        type inet:ipv6-address;
        description "Mobility service IPv6 address.";
      }
    }
  }

  grouping ipv6-fqdn-mos-option-group {
    description "OPTION-IPv6_FQDN-MoS (55) IPv6 FQDN MoS Option.";
    reference "RFC 5678: Dynamic Host Configuration Protocol (DHCPv4
      and DHCPv6) Options for IEEE 802.21 Mobility Services (MoS)
      Discovery";
    container ipv6-fqdn-mos-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION-IPv6_FQDN-MoS (55) IPv6 FQDN MoS Option
        option.";
      leaf service-type {
        type uint16;
        description "IEEE 802.21 service type.";
      }
      leaf-list server-fqdn {
        type inet:domain-name;
        description "Mobility service domain name.";
      }
    }
  }

  augment
    "/dhc6-srv:dhcpv6-server/"
      + "dhc6-srv:option-sets/"
      + "dhc6-srv:option-set" {
    description "Add RFC 5678 options.";
    uses ipv6-address-mos-option-group;
    uses ipv6-fqdn-mos-option-group;
  }

}
