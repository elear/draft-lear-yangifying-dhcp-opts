module ietf-dhcpv6-opt-geolocation {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-geolocation";
  prefix geolocat;

  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 6225:
      Geolocation Information for DHCP.";
  reference "RFC 6225: Geolocation Information for DHCP";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 6225: Geolocation Information for DHCP";
  }

  grouping geolocation-option-group {
    description "OPTION_GEOLOCATION (63) Geolocation Option.";
    reference "RFC 6225: Geolocation Information for DHCP";
    container geolocation-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_GEOLOCATION (63) Geolocation Option option.";
      leaf latitude {
        type uint32;
        description "Latitude value.";
      }
      leaf latitude-resolution {
        type uint8;
        description "Latitude resolution.";
      }
      leaf longitude {
        type uint32;
        description "Longitude value.";
      }
      leaf longitude-resolution {
        type uint8;
        description "Longitude resolution.";
      }
      leaf altitude {
        type int32;
        description "Altitude value.";
      }
      leaf altitude-type {
        type uint8;
        description "Altitude type.";
      }
      leaf altitude-resolution {
        type uint8;
        description "Altitude resolution.";
      }
    }
  }

  augment
    "/dhc6-srv:dhcpv6-server/"
      + "dhc6-srv:option-sets/"
      + "dhc6-srv:option-set" {
    description "Add RFC 6225 options.";
    uses geolocation-option-group;
  }

}
