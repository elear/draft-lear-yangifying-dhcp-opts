module ietf-dhcpv6-opt-subscriber-id {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-subscriber-id";
  prefix subscrib;

  import ietf-dhcpv6-relay {
    prefix dhc6-rly;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 4580: DHCPv6
      Relay Agent Subscriber-ID Option.";
  reference "RFC 4580: DHCPv6 Relay Agent Subscriber-ID Option";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 4580: DHCPv6 Relay Agent Subscriber-ID Option";
  }

  grouping subscriber-id-option-group {
    description "OPTION_SUBSCRIBER_ID (38) Subscriber-ID Option.";
    reference "RFC 4580: DHCPv6 Relay Agent Subscriber-ID Option";
    container subscriber-id-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_SUBSCRIBER_ID (38) Subscriber-ID Option
        option.";
      leaf subscriber-id {
        type binary;
        description "Subscriber identifier octets.";
      }
    }
  }

  augment
    "/dhc6-rly:dhcpv6-relay/"
      + "dhc6-rly:relay-if/"
      + "dhc6-rly:relay-options" {
    description "Add RFC 4580 options.";
    uses subscriber-id-option-group;
  }

}
