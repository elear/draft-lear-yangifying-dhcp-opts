module ietf-dhcpv6-opt-pcp {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:"
    + "ietf-dhcpv6-opt-pcp";
  prefix pcp;

  import ietf-inet-types {
    prefix inet;
    reference
      "RFC 6991: Common YANG Data Types";
  }
  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6
       Configuration";
  }

  organization
    "IETF Dynamic Host Configuration (DHC) Working Group";
  contact
    "DHC Working Group
     WG Web: <https://datatracker.ietf.org/wg/dhc/>
     WG List: <mailto:dhcwg@ietf.org>";
  description
     "This module defines the DHCPv6 options from RFC 7291: DHCP
      Options for the Port Control Protocol (PCP).";
  reference "RFC 7291: DHCP Options for the Port Control Protocol
    (PCP)";

  revision 2026-11-19 {
    description "Initial revision.";
    reference "RFC 7291: DHCP Options for the Port Control Protocol
      (PCP)";
  }

  grouping v6-pcp-server-option-group {
    description "OPTION_V6_PCP_SERVER (86) PCP Server Option.";
    reference "RFC 7291: DHCP Options for the Port Control Protocol
      (PCP)";
    container v6-pcp-server-option {
      presence "Configures this DHCPv6 option.";
      description "OPTION_V6_PCP_SERVER (86) PCP Server Option option.";
      leaf-list pcp-server-address {
        type inet:ipv6-address;
        description "PCP server IPv6 address.";
      }
    }
  }

  augment
    "/dhc6-srv:dhcpv6-server/"
      + "dhc6-srv:option-sets/"
      + "dhc6-srv:option-set" {
    description "Add RFC 7291 options.";
    uses v6-pcp-server-option-group;
  }

}
