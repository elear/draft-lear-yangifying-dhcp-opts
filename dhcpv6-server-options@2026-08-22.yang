module example-dhcpv6-server-options {
  yang-version 1.1;
  namespace
    "urn:ietf:params:xml:ns:yang:ietf-dhcpv6-server-options";
  prefix dhc6-so;

  import ietf-inet-types {
    prefix inet;
    revision-date 2013-07-15;
    reference
      "RFC 6991: Common YANG Data Types";
  }
  import ietf-dhcpv6-server {
    prefix dhc6-srv;
    revision-date 2022-06-20;
    reference
      "RFC 9243: A YANG Data Model for DHCPv6 Configuration";
  }

  organization
    "IETF DHC Working Group";
  contact
    "WG Website: https://datatracker.ietf.org/wg/dhc/
     WG List: dhcpwg@ietf.org

     Name: Eliot Lear
     Email: lear@cisco.com";
  description
    "This module augments the DHCPv6 server schema defined by
     RFC 9243.  It models every assigned, non-obsolete option that the
     IANA DHCPv6 Option Codes registry, as retrieved on 2026-08-22,
     marks as requestable in a client Option Request Option, except
     options already represented in the RFC 9243 server model.

     This scope covers standardized server-supplied configuration.
     Client-originated, relay, leasequery, failover, protocol-internal,
     and other options whose Client ORO value is 'No' are outside the
     scope of an RFC 9243 server option-set augmentation.

     In accordance with RFC 9243 Appendix B, every option has a
     separate grouping, an IANA-derived option name, a code-bearing
     description, and a reference to its defining RFC.  Fields use
     YANG scalar, list, or leaf-list types when the RFC wire format has
     an unambiguous configuration representation.  Complex options
     whose subfields require a dedicated option-specific data model
     retain their ordered OPTION_DATA as binary; this avoids inventing
     semantics while preserving the defining RFC's format.";

  revision 2026-08-22 {
    description
      "Initial revision.";
    reference
      "RFC XXXX: YANG Module for DHCPv6 Server Options";
  }

  /*
   * Option groupings
   */
  grouping sip-server-domain-name-list-option-group {
    description
      "OPTION_SIP_SERVER_D (21) option.";
    reference
      "RFC 3319: Dynamic Host Configuration Protocol (DHCPv6) Options
       for Session Initiation Protocol (SIP) Servers.";
    container sip-server-domain-name-list-option {
      presence
        "Configure OPTION_SIP_SERVER_D (21).";
      description
        "OPTION_SIP_SERVER_D (21) option configuration.";
      leaf-list domain-name {
        type inet:domain-name;
        min-elements 1;
        ordered-by user;
        description
          "Domain names in wire order.";
      }
    }
  }

  grouping sip-server-address-list-option-group {
    description
      "OPTION_SIP_SERVER_A (22) option.";
    reference
      "RFC 3319: Dynamic Host Configuration Protocol (DHCPv6) Options
       for Session Initiation Protocol (SIP) Servers.";
    container sip-server-address-list-option {
      presence
        "Configure OPTION_SIP_SERVER_A (22).";
      description
        "OPTION_SIP_SERVER_A (22) option configuration.";
      leaf-list server-address {
        type inet:ipv6-address;
        min-elements 1;
        ordered-by user;
        description
          "IPv6 server addresses in wire order.";
      }
    }
  }

  grouping dns-recursive-name-server-option-group {
    description
      "OPTION_DNS_SERVERS (23) option.";
    reference
      "RFC 3646: DNS Configuration options for DHCPv6.";
    container dns-recursive-name-server-option {
      presence
