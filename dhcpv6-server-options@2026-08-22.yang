  grouping additional-server-options {
    description
      "Standardized server-supplied DHCPv6 options not represented in
       the RFC 9243 server option-set schema.";
    uses sip-server-domain-name-list-option-group;
    uses sip-server-address-list-option-group;
    uses dns-recursive-name-server-option-group;
    uses domain-search-list-option-group;
    uses nis-server-address-list-option-group;
    uses nisp-server-address-list-option-group;
    uses nis-domain-name-option-group;
    uses nisp-domain-name-option-group;
    uses sntp-server-address-list-option-group;
    uses bcmcs-server-domain-name-list-option-group;
    uses bcmcs-server-address-list-option-group;
    uses geoconf-civic-option-group;
    uses client-fqdn-option-group;
    uses pana-agent-option-group;
    uses posix-timezone-option-group;
    uses tzdb-timezone-option-group;
    uses mip6-home-network-id-fqdn-option-group;
    uses mip6-visited-home-network-info-option-group;
    uses lost-server-domain-name-option-group;
    uses capwap-ac-address-list-option-group;
    uses mos-ipv6-address-option-group;
    uses mos-ipv6-fqdn-option-group;
    uses ntp-server-option-group;
    uses access-network-domain-name-option-group;
    uses sip-ua-configuration-service-domains-option-group;
    uses boot-file-url-option-group;
    uses boot-file-parameter-option-group;
    uses network-interface-id-option-group;
    uses geolocation-option-group;
    uses aftr-name-option-group;
    uses erp-local-domain-name-option-group;
    uses mip6-identifier-information-option-group;
    uses mip6-update-notification-information-option-group;
    uses mip6-home-network-prefix-option-group;
    uses mip6-home-agent-address-option-group;
    uses mip6-home-agent-fqdn-option-group;
    uses recursive-dns-server-selection-option-group;
    uses kerberos-principal-name-option-group;
    uses kerberos-realm-name-option-group;
    uses kerberos-default-realm-name-option-group;
    uses kerberos-kdc-option-group;
    uses address-selection-policy-option-group;
    uses address-selection-policy-table-option-group;
    uses pcp-server-option-group;
    uses dhcpv4-over-dhcpv6-server-option-group;
    uses s46-border-relay-option-group;
    uses s46-mape-container-option-group;
    uses s46-mapt-container-option-group;
    uses s46-lw4over6-container-option-group;
    uses four-rd-container-option-group;
    uses four-rd-map-rule-option-group;
    uses four-rd-non-map-rule-option-group;
    uses captive-portal-option-group;
    uses mpl-parameters-option-group;
    uses s46-priority-option-group;
    uses sztp-redirect-option-group;
    uses dots-reference-identifier-option-group;
    uses dots-address-option-group;
    uses andsf-ipv6-address-option-group;
    uses v6-dnr-option-group;
    uses registered-domain-option-group;
    uses forward-distribution-manager-option-group;
    uses reverse-distribution-manager-option-group;
    uses address-registration-enable-option-group;
  }

  augment "/dhc6-srv:dhcpv6-server/dhc6-srv:option-sets/"
        + "dhc6-srv:option-set" {
    description
      "Add the uncovered standardized server options to each RFC 9243
       DHCPv6 option set.";
    uses additional-server-options;
  }
}
